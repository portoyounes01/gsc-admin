# Copy to deploy/.env and fill in. Note: env_file values are literal (no ${} expansion),
# so write the real values here. Only docker-compose.yml interpolates variables.

# Public hostnames (DNS A records must point to the VPS before first start, or Caddy cannot get certificates)
ADMIN_HOST=admin.example.be
API_HOST=api.example.be

# Database
POSTGRES_DB=gsc_dashboard
POSTGRES_USER=gsc
POSTGRES_PASSWORD=CHANGE-ME-long-random

# Backend
ENVIRONMENT=staging
# Generate with: openssl rand -hex 32
SECRET_KEY=CHANGE-ME-run-openssl-rand-hex-32
ACCESS_TOKEN_MINUTES=480
CORS_ORIGINS=https://admin.example.be
BOOTSTRAP_ADMIN_EMAIL=admin@example.be
BOOTSTRAP_ADMIN_PASSWORD=CHANGE-ME-strong-password
PLANNING_RETENTION_DAYS=365
GEOCODING_OUTBOUND_ENABLED=true
ROUTING_PROVIDER=osrm
ROUTING_OUTBOUND_ENABLED=true
ROUTING_OSRM_BASE_URL=http://osrm:5000
ROUTING_GOOGLE_API_KEY=

# Frontend build (baked in at build time)
VITE_CARTO_BASEMAP_KEY=
